{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@aquarius/core": ["./packages/core/src/index.ts"],
      "@aquarius/core/adapter": ["./packages/core/src/adapter/index.ts"],
      "@aquarius/core/runtime": ["./packages/core/src/runtime/index.ts"],
      "@aquarius/core/cli": ["./packages/core/src/cli/index.ts"],
      "@aquarius/codex": ["./packages/codex/src/index.ts"],
      "@aquarius/rules": ["./packages/rules/src/index.ts"]
    }
  }
}
