      "import": "./dist/adapter.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.mjs"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --project tsconfig.json --noEmit",
