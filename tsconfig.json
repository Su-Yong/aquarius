{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "paths": {
      "@aquarius/core": [
        "./packages/core/src/index.ts"
      ],
      "@aquarius/core/internal": [
        "./packages/core/src/internal.ts"
      ],
      "@aquarius/rules": [
        "./packages/rules/src/index.ts"
      ]
    }
  }
}
