  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@aqtools/core": ["./packages/core/src/index.ts"],
      "@aqtools/core/adapter": ["./packages/core/src/adapter/index.ts"],
      "@aqtools/core/runtime": ["./packages/core/src/runtime/index.ts"],
      "@aqtools/core/cli": ["./packages/core/src/cli/index.ts"],
      "@aqtools/antigravity": ["./packages/antigravity/src/index.ts"],
      "@aqtools/codex": ["./packages/codex/src/index.ts"],
      "@aqtools/rules": ["./packages/rules/src/index.ts"]
    }
  }
}
