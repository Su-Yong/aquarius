{
  "name": "aqlint",
  "version": "0.1.0",
  "description": "AI-driven, rule-based code diagnostics",
  "type": "module",
  "bin": {
    "aqlint": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.11.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Su-Yong/aquarius.git",
    "directory": "packages/aqlint"
  },
  "dependencies": {
    "@aquarius/core": "workspace:*",
    "@aquarius/rules": "workspace:*",
    "zod": "4.6.7"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "start": "node dist/cli.mjs",
    "test": "vitest run"
  }
}
